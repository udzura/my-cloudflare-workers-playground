{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hello-mruby",
	"main": "src/index.js",
	"compatibility_date": "2026-08-22",
	"build": {
		"command": "bundle exec rake build",
		"watch_dir": [
			"app.rb",
			"build_config.rb"
		]
	},
	"rules": [
		{
			"type": "Data",
			"globs": [
				"**/*.bin"
			],
			"fallthrough": true
		}
	],
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "hello-mruby-documents",
			"remote": true
		}
	],
	// "queues": {
	// 	"producers": [
	// 		{
	// 			"binding": "EVENTS",
	// 			"queue": "events"
	// 		}
	// 	]
	// },
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSIONS",
				"class_name": "PicoRubyDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PicoRubyDurableObject"
			]
		}
	],
	"vars": {
		// Set your team name (the prefix of <team>.cloudflareaccess.com).
		"CF_ACCESS_TEAM": "test",
		"GREETING": "Hello from PicoRuby on Cloudflare!"
	}
	// Keep secrets out of this file; use .dev.vars and wrangler secret put.
}